# Copy to .env and adjust. All values are optional; the defaults run fully offline.
SOUSCHEF_LLM_BACKEND=stub          # stub | ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
SOUSCHEF_RETRIEVER=hybrid          # bm25 | dense | hybrid
SOUSCHEF_TOP_K=4
SOUSCHEF_PROMPT_VERSION=v2
SOUSCHEF_EMBEDDING_BACKEND=lsa     # lsa | sentence-transformers
SOUSCHEF_EMBEDDING_MODEL=all-MiniLM-L6-v2
# SOUSCHEF_DATA_DIR=./data
# SOUSCHEF_INDEX_DIR=./.cache/index
# SOUSCHEF_DB_PATH=./.cache/souschef.db
